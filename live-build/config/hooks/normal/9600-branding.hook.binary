#!/bin/sh
# Rebrand the bootloader menus (isolinux/BIOS + grub/UEFI) from live-build's
# stock "Debian GNU/Linux" art to Sysible Linux. Path-agnostic: it discovers the
# actual bootloader config + splash files in the assembled binary/ tree, because
# their exact locations vary by live-build version. Diagnostics are printed so
# the build log shows precisely what was found and changed.
set -e
echo "===== Sysible branding hook: discovering bootloader tree ====="
find binary -maxdepth 4 -type f \( -name '*.cfg' -o -name 'splash.png' -o -name 'splash.svg' -o -name 'splash.tga' \) 2>/dev/null | sort || true
echo "----- files mentioning Debian/Live system -----"
DEBIAN_CFGS=$(find binary -maxdepth 4 -type f -name '*.cfg' 2>/dev/null \
    | xargs grep -Il 'Debian GNU/Linux\|Live system\|menu title' 2>/dev/null || true)
echo "$DEBIAN_CFGS"

echo "===== rebranding config text ====="
for f in $DEBIAN_CFGS; do
    [ -f "$f" ] || continue
    sed -i \
        -e 's|Debian GNU/Linux - live (fail-safe mode)|Sysible Linux (Live, safe graphics)|g' \
        -e 's|Debian GNU/Linux - live|Sysible Linux (Live)|g' \
        -e 's|Live system (\(.*\) fail-safe mode)|Sysible Linux (Live, safe graphics) [\1]|g' \
        -e 's|Live system (\(.*\))|Sysible Linux (Live) [\1]|g' \
        -e 's|^menu title .*|menu title Sysible Linux|' \
        -e 's|Debian GNU/Linux|Sysible Linux|g' \
        "$f"
    echo "  rebranded: $f"
done

echo "===== replacing splash images ====="
if [ -f config/branding/splash.png ]; then
    for sp in $(find binary -maxdepth 4 -type f -name 'splash.png' 2>/dev/null); do
        cp config/branding/splash.png "$sp" && echo "  splash.png -> $sp"
    done
fi
# Some live-build versions render the isolinux splash from splash.svg at build
# time; drop a same-named PNG next to it and repoint any menu that references it.
for svg in $(find binary -maxdepth 4 -type f -name 'splash.svg' 2>/dev/null); do
    echo "  found splash.svg: $svg (isolinux uses the .png; leaving svg in place)"
done

echo "===== Sysible branding hook: done ====="
