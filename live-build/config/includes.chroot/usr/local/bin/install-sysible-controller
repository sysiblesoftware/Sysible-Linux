#!/bin/sh
# Download and install Sysible Controller CE on demand. Shipped on the ISO as a
# desktop launcher — nothing about the Controller is baked into the image except
# this small helper, so a fresh workstation runs no Controller services and opens
# no ports until the user chooses to install it.
set -e

REPO="https://github.com/sysiblesoftware/sysible-controller"
echo "============================================================"
echo " Install Sysible Controller CE"
echo " Source: $REPO"
echo "============================================================"
echo
echo "This downloads the Controller and runs its installer (needs sudo)."
echo "It installs to /opt/sysible and enables the backend + web console."
echo
printf "Continue? [y/N] "
read ans
case "$ans" in
    y|Y|yes|YES) ;;
    *) echo "Cancelled."; exit 0 ;;
esac

command -v git >/dev/null 2>&1 || { echo "git is required."; exit 1; }

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
echo "== cloning =="
git clone --depth 1 "$REPO" "$TMP/src"

echo "== running installer (sudo) =="
cd "$TMP/src"
sudo ./install_sysible.sh "$@"

echo
echo "Done. Open the console at http://localhost:8800"
printf "Press Enter to close..."
read _
