[org.gnome.shell]
enabled-extensions=['ding@rastersoft.com', 'dash-to-dock@micxgx.gmail.com']
favorite-apps=['systerm.desktop', 'firefox-esr.desktop', 'code.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Nautilus.desktop']

[org.gnome.desktop.default-applications.terminal]
exec='systerm'
exec-arg='-e'

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
intellihide=false
# The dock pins only the five apps in favorite-apps (SysTerm, Firefox, VS Code,
# Text Editor, Files). The "Show Applications" grid button gives access to
# everything else, so keep it on and put it at the end of the dock.
show-show-apps-button=true
show-apps-at-top=false
show-trash=false
show-mounts=false
custom-theme-shrink=true
transparency-mode='FIXED'
background-opacity=0.85
custom-background-color=true
background-color='#0d1117'
